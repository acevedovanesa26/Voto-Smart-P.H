# VotoSmart Environment Variables

# GEMINI_API_KEY: Clave de la API de Google Gemini para generación de resúmenes de asambleas
GEMINI_API_KEY=

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://votosmart_user:votosmart_password@localhost:5432/votosmart_db

# Seguridad y Autenticación
JWT_SECRET=super_secret_jwt_key_votosmart_2026_change_in_production
PORT=3000

# Configuración de Servidor de Correo (100% GRATIS)
# Opción A: Gmail (Gratis hasta 500 correos/día con "Contraseña de Aplicación" de Google)
# 1. Ve a https://myaccount.google.com/security
# 2. Activa "Verificación en dos pasos" si aún no la tienes
# 3. Busca "Contraseñas de aplicaciones" y genera una con nombre "VotoSmart"
# 4. Coloca el correo y la clave de 16 caracteres aquí:
GMAIL_USER=tu_correo@gmail.com
GMAIL_PASS=abcd efgh ijkl mnop

# Opción B: Brevo / Sendinblue (Gratis 300 correos/día para siempre, sin tarjeta)
# 1. Regístrate gratis en https://www.brevo.com
# 2. Ve a Configuración > SMTP & API > SMTP y copia tus datos:
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USERNAME=tu_usuario_smtp_brevo
# EMAIL_PASSWORD=tu_clave_master_brevo
# EMAIL_FROM="VotoSmart <tu_correo_verificado@tudominio.com>"

# Opción C: Resend (Gratis 3,000 correos/mes)
# 1. Crea cuenta en https://resend.com
# 2. Genera una API Key:
# RESEND_API_KEY=re_123456789
# EMAIL_FROM="VotoSmart <onboarding@resend.dev>"

# Configuración Genérica SMTP (Fallback):
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# URLs de la Aplicación
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
